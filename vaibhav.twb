      <column caption='Student vs Teacher Difference' datatype='real' name='[Calculation_1355200958107649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Student AI Usage Pct] - [Teacher AI Usage Pct]' />
      </column>
      <column caption='Urban vs Rural Difference' datatype='real' name='[Calculation_1355200958193666]' role='measure' type='quantitative'>
