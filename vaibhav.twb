      </column>
      <column caption='Government Policy Status' datatype='string' name='[Calculation_1355200958271491]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([government_ai_policy]) THEN&#13;&#10;    &quot;Not Available&quot;&#13;&#10;ELSE&#13;&#10;    [government_ai_policy]&#13;&#10;END' />
