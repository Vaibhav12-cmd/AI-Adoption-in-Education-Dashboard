      <column caption='AI Adoption Level' datatype='real' name='[Calculation_1355200964833284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  &lt; 25 THEN&#13;&#10;    &quot;Low&quot;&#13;&#10;ELSEIF  &lt; 50 THEN&#13;&#10;    &quot;Medium&quot;&#13;&#10;ELSE&#13;&#10;    &quot;High&quot;&#13;&#10;END' />
